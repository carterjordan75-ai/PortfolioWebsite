# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Raw source assets (not deployed) — keep these out of the repo; only
# files inside public/assets are shipped to production.
/Assets/

# Standalone side projects that happen to live in this folder but deploy
# on their own (Cloudflare Worker, etc). They carry their own node_modules
# and must not be pushed with the website.
/property-watch/

# Blob storage mirror, written by scripts/pull-assets.mjs.
# Ignored by default because it is ~184MB of binaries and git keeps them
# forever — a repo you clone pays that cost on every checkout. Delete
# these two lines if you would rather the media were versioned; that is
# a deliberate trade, not an oversight.
assets-backup/
